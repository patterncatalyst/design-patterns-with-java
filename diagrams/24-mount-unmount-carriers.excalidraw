   "versionNonce": 1543648858,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The JVM scheduler, not the OS, decides which virtual thread rides which carrier",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The JVM scheduler, not the OS, decides which virtual thread rides which carrier",
   "lineHeight": 1.25,
   "baseline": 13
  }
