   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Mounting is cheap: no OS thread created per task",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Mounting is cheap: no OS thread created per task",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1353566348",
   "type": "text",
   "x": 480,
   "y": 335,
   "width": 564.85,
   "height": 16.25,
   "angle": 0,
   "strokeColor": "#888888",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
