<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 29 — Seams and the test safety net: getting a hard-wired shipment
  escalation service and a risk scorer under test before changing them.

  Standalone-buildable: `cd examples/29-seams && mvn test` works without
  touching the aggregator. Also picked up by ../pom.xml's <modules>, so
  `mvn -f examples/pom.xml test` builds this module too. No containers —
  plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-29-seams</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch29 Seams and the test safety net</name>
    <description>
        A hard-wired shipment escalation service (reads the wall clock inline
        and news its own carrier gateway) and a risk scorer that reads a
        global peak-season calendar, both gotten under test before they are
        changed: characterization tests pin the inherited behavior, an object
        seam (java.time.Clock) and an extract-interface seam (CarrierGateway)
        make the escalation service's collaborators substitutable with a
        Mockito mock, and a subclass-and-override seam substitutes the risk
        scorer's one hard dependency through a test subclass with no
        constructor change.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
