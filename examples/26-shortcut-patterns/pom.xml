<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 26 — Shortcut patterns: dispatch tables and maps.

  Standalone-buildable: `cd examples/26-shortcut-patterns && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's <modules>
  once the orchestrator wires it in. No containers — plain Maven + JDK 25,
  per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-26-shortcut-patterns</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch26 Shortcut patterns</name>
    <description>
        Two idiomatic Java 25 dispatch shortcuts against a shipping event
        domain: an EnumMap built from an exhaustive switch expression over a
        closed ShipmentEventType, and a Map&lt;String, handler&gt; dispatch
        table for an open set of carrier webhook codes, registered at
        runtime with a fallback for an unrecognized code. A shared
        ShipmentLedger and a set of short handler methods keep the routing
        mechanism separate from the behavior it selects.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
