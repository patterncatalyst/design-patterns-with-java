<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 27 — Anti-patterns and pattern misuse: shipping-rate pricing.

  Standalone-buildable: `cd examples/27-anti-patterns && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-27-anti-patterns</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch27 Anti-patterns and pattern misuse</name>
    <description>
        A shipping-rate pricing calculation shown two ways: an over-engineered
        design (overengineered package) that chains a singleton surcharge
        registry through a factory-of-factories into a god object with a
        leaky abstraction, and the simplified, appropriate form,
        ShipmentPricingService, built from one RateSettings record and one
        class. The test suite proves the over-engineered design's two costs,
        spooky action at a distance through the shared singleton and a leaky
        surcharge flag, and proves the simplified rewrite computes the
        identical answer while fixing both.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
