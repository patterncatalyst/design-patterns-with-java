<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 13 — Builder and Prototype: assembling an international shipment.

  Standalone-buildable: `cd examples/13-builder-prototype && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's <modules>,
  so `mvn -f examples/pom.xml test` builds this module too. No containers —
  plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-13-builder-prototype</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch13 Builder and Prototype</name>
    <description>
        A Bloch-style Shipment.Builder that accumulates required and optional
        shipping fields and validates every cross-field invariant exactly
        once, at build(); a CustomsDeclaration record with wither methods for
        deriving a changed copy; and a Prototype PackagingCatalog that clones
        a named, pre-configured PackagingTemplate exemplar into a fresh,
        independently owned copy.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
