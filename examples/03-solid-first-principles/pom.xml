<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 3 — SOLID I: SRP / OCP / LSP, in a freight-billing engine.

  Standalone-buildable: `cd examples/03-solid-first-principles && mvn test`
  works without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-03-solid-first-principles</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch03 SOLID I</name>
    <description>
        Single Responsibility, Open/Closed, and Liskov Substitution against a
        freight-billing engine. SRP splits calculation, formatting, and
        persistence into three types with one reason to change each; OCP
        extends the rule catalogue through an InvoiceRule abstraction that a
        brand-new rule type can satisfy without an edit to InvoiceCalculator;
        LSP clamps a discount rule's output inside a final method so every
        subtype inherits the invariant instead of reimplementing it, with a
        companion rule that skips the base class on purpose to show what
        breaks when a subtype does not honor the parent's contract.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
