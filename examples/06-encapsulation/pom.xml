<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 6 — Encapsulation and API design, in a shipping-tracking gateway.

  Standalone-buildable: `cd examples/06-encapsulation && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-06-encapsulation</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch06 Encapsulation and API design</name>
    <description>
        A shipping-tracking gateway that hides its implementation two ways:
        a public ShippingGateway interface reached only through a static
        factory, with a package-private InMemoryShippingGateway no caller
        outside the package can name; and a Shipment/Manifest/TrackingHistory
        value model built from records whose compact constructors defend
        every collection field with List.copyOf.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
