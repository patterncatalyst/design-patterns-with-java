<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 23 — Where Java 25 retires classic idioms. The book's
  through-line capstone, carried as four modern forms with tests: an enum
  singleton replacing double-checked locking, a record (plus a second
  record demonstrating defensive copying) replacing a hand-written value
  class, a sealed interface with an exhaustive pattern-matching switch
  replacing a double-dispatch Visitor or an instanceof-cast chain, and an
  Optional-returning lookup replacing a Null Object and scattered null
  checks.

  Standalone-buildable: `cd examples/23-idiom-retirement && mvn test`
  works without touching the aggregator. Also picked up by ../pom.xml's
  <modules>. No containers — plain Maven + JDK 25, per the repo's
  CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-23-idiom-retirement</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch23 Where Java 25 retires classic idioms</name>
    <description>
        ConfirmationNumberGenerator (enum singleton) retires double-checked
        locking. ShippingAddress and DeliveryManifest (records) retire a
        hand-written value class's getters, equals, hashCode, toString, and
        defensive copying. ShipmentEvent (sealed interface) with
        ShipmentEventNarrator's exhaustive pattern-matching switch retires
        a double-dispatch Visitor and an instanceof-cast chain.
        PreferredCarrierDirectory and ShipmentRouter (Optional) retire a
        Null Object and scattered null checks.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
