<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 31 — Characterization tests; Fowler vs Feathers. A gnarly,
  untested legacy freight-quote calculator carries this chapter's
  characterization-test suite, and a Fowler-style refactor (Extract
  Function, Replace Conditional with Polymorphism, Introduce Parameter
  Object) reshapes it under that suite without changing a single pinned
  output, quirks included.

  Standalone-buildable: `cd examples/31-characterization && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-31-characterization</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch31 Characterization tests; Fowler vs Feathers</name>
    <description>
        LegacyFreightQuoteCalculator: an inherited, untested freight-quote
        calculator with three boundary quirks (a truncating weight tier, a
        strict residential threshold, a truncated declared-value surcharge).
        FreightQuoteCharacterizationTest pins its current behavior, quirks
        included, with a parameterized table of representative and boundary
        inputs. FreightQuoteCalculator is the Fowler-refactored form
        (Extract Function, Replace Conditional with Polymorphism via
        CarrierProfile, Introduce Parameter Object via ShipmentDetails),
        re-run against the same pinned table to prove the refactor changed
        nothing a caller can observe.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
