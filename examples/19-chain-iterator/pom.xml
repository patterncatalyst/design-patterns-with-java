<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 19 — Chain of Responsibility and Iterator: shipment approval and a
  zone-bucketed manifest.

  Standalone-buildable: `cd examples/19-chain-iterator && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-19-chain-iterator</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch19 Chain of Responsibility and Iterator</name>
    <description>
        Chain of Responsibility and Iterator against a shipment-approval and
        warehouse-manifest domain. An object chain of ApprovalHandler
        subclasses and an equivalent functional composition of checks both
        route an ApprovalRequest to the first rule that fires, falling back
        to manual review when none does. A ShipmentManifest hides its
        internal zone-bucketed storage behind a hand-written Iterable and
        Iterator, and exposes the identical traversal as a Stream built on
        Iterable's default spliterator() method.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
