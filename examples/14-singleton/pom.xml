<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 14 — Singleton and the DI alternative. A carrier rate table
  shown as both of the two modern singleton idioms (enum singleton and the
  initialization-on-demand holder idiom), plus a dependency-injection
  alternative that receives the same capability through a constructor
  instead of reaching into a global.

  Standalone-buildable: `cd examples/14-singleton && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-14-singleton</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch14 Singleton and the DI alternative</name>
    <description>
        A carrier rate-table domain built two ways as a singleton, the enum
        singleton CarrierRateTable and the initialization-on-demand holder
        idiom HolderCarrierRateTable, both behind a shared RateLookup
        contract. WarehousePricingJob shows the hidden-dependency cost of
        reaching into the global directly; ShippingQuoteService shows the
        constructor-injected alternative, tested with a Mockito double to
        prove the substitutability a global singleton cannot offer.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
