<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 4 — SOLID II: ISP / DIP and dependency injection without a
  framework. An order-notification domain, built around a fat interface
  segregated into role interfaces and a high-level policy that depends on
  one of those abstractions instead of a concrete gateway.

  Standalone-buildable: `cd examples/04-dependency-inversion && mvn test`
  works without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-04-dependency-inversion</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch04 ISP / DIP</name>
    <description>
        An order-notification domain that segregates a fat NotificationGateway
        into MessageSender, TemplateRenderer, and DeliveryStatusProvider role
        interfaces (ISP), then inverts the dependency between a high-level
        OrderNotificationPolicy and the concrete EmailGateway/SmsGateway
        details so both sides depend on MessageSender instead (DIP). A plain
        Java composition root wires the object graph by hand, with no DI
        framework.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
