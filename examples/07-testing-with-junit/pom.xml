<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 7 — Testing with JUnit 5, Mockito, and AssertJ. A shipment-booking
  domain built specifically to exercise the full testing stack this book
  runs behind every other chapter: JUnit 5 lifecycle and parameterized
  tests, Mockito mocks/spies/captors, and AssertJ fluent assertions.

  Standalone-buildable: `cd examples/07-testing-with-junit && mvn test`
  works without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-07-testing-with-junit</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch07 Testing with JUnit 5, Mockito, AssertJ</name>
    <description>
        A shipment-booking domain (ShipmentValidator, FreightCostCalculator,
        RateLedger, ShipmentBookingService) built to carry the test suite
        this chapter teaches from: JUnit 5's lifecycle, @Nested grouping,
        and parameterized tests (@ValueSource/@EnumSource/@MethodSource),
        Mockito mocks, spies, argument matchers and ArgumentCaptor, and
        AssertJ fluent assertions. The tests ARE the worked examples.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
