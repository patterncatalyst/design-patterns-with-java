<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 34 — Working with AI and LLM tools: a return-eligibility
  verification gate.

  Standalone-buildable: `cd examples/34-ai-verification-gate && mvn test`
  works without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-34-ai-verification-gate</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch34 Working with AI and LLM tools</name>
    <description>
        A verification gate for an AI-drafted Strategy: a ReturnEligibilityStrategy
        contract, a drafted implementation that honors every boundary a return
        policy specifies, and a plausible-looking but wrong draft carrying a
        single off-by-one comparison. A behavior-test suite run against the
        policy's exact boundary table accepts the correct draft and rejects the
        wrong one, and a RefundPolicy turns the misclassification into an actual
        dollar figure.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
