<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 30 — Dependency-breaking techniques for Java: a hard-wired
  shipment dispatcher made testable.

  Standalone-buildable: `cd examples/30-dependency-breaking && mvn test`
  works without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-30-dependency-breaking</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch30 Dependency-breaking techniques</name>
    <description>
        Feathers' dependency-breaking techniques applied to a hard-wired
        LegacyShipmentProcessor: Extract Interface plus Parameterize
        Constructor open a seam around a concrete SMTP notification
        dependency, Extract and Override Factory Method opens a seam around
        an embedded surcharge-calculator construction, Subclass and
        Override Method isolates a wall-clock read behind an overridable
        hook, and Adapt Parameter shrinks a heavyweight manifest-file
        parameter down to the two values a caller actually reads.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
