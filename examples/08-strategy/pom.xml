<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 8 — Strategy: shipping-rate quoting.

  Standalone-buildable: `cd examples/08-strategy && mvn test` works without
  touching the aggregator. Also picked up by ../pom.xml's <modules>, so
  `mvn -f examples/pom.xml test` builds this module too. No containers —
  plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-08-strategy</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch08 Strategy</name>
    <description>
        Three idiomatic Java 25 expressions of Strategy against a shipping-rate
        quoting domain: a Classic Java interface with named concrete
        implementations, the same RateStrategy contract assigned directly as a
        lambda with a composition helper, and a closed set of carriers
        expressed as enum constants that each carry their own algorithm. A
        shared RateQuote/Shipment/Money value model and a single pricing-math
        utility keep the three expressions provably identical in behavior.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
