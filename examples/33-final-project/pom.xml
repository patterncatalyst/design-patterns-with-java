<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 33 — Final project: a shipment dispatch center composing Builder,
  State, Command, Observer, and Strategy into one running system.

  Standalone-buildable: `cd examples/33-final-project && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too.
  No containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-33-final-project</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch33 Final project</name>
    <description>
        The book's final project: a shipment dispatch center that composes
        Builder, State, Command, Observer, and Strategy into one running
        system. A ShipmentBuilder resolves a carrier's RateStrategy and
        produces an opening quote; Shipment is both the State machine's
        context and the Observer's subject; AdvanceShipmentCommand,
        AdjustWeightCommand, and SwitchRateStrategyCommand each wrap one
        reversible operation through a CommandHistory undo/redo stack; and
        ShipmentDispatchCenter is the single composition root that wires
        every pattern together.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
