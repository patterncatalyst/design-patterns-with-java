<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 20 — Visitor, Memento, Interpreter: a shipping manifest.

  Standalone-buildable: `cd examples/20-visitor-memento-interpreter && mvn test`
  works without touching the aggregator. No containers — plain Maven + JDK 25,
  per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-20-visitor-memento-interpreter</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch20 Visitor, Memento, Interpreter</name>
    <description>
        A fixed ManifestEntry hierarchy operated on by three Visitor
        operations expressed as exhaustive pattern-matching switches with no
        accept() method anywhere, a ManifestDraft Originator whose
        package-private Snapshot record captures and restores whole state
        for undo, and a small sealed SurchargeExpr grammar evaluated by
        record-pattern switches where nesting decides the result.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
