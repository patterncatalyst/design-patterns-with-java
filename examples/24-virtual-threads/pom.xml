<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 24 — Virtual threads: fanning a shipping-rate quote out to many
  carriers at once.

  Standalone-buildable: `cd examples/24-virtual-threads && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's <modules>,
  so `mvn -f examples/pom.xml test` builds this module too. No containers —
  plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-24-virtual-threads</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch24 Virtual threads</name>
    <description>
        A rate-quote fan-out against a shipping domain: one virtual thread per
        carrier call via Executors.newVirtualThreadPerTaskExecutor(), a
        Semaphore-bounded variant that caps concurrent in-flight calls without
        pooling virtual threads, and a ReentrantLock-guarded shared cache that
        many virtual threads update concurrently while fanning out.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
