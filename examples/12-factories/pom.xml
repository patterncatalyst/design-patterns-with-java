<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 12 — Factory Method and Abstract Factory: a regional shipping
  compliance desk.

  Standalone-buildable: `cd examples/12-factories && mvn test` works without
  touching the aggregator. Also picked up by ../pom.xml's <modules> once the
  orchestrator wires it in, so `mvn -f examples/pom.xml test` builds this
  module too. No containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-12-factories</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch12 Factory Method and Abstract Factory</name>
    <description>
        An Abstract Factory, ShippingToolkit, that hands out a matching family
        of label formatter, rate table, and customs form per shipping region,
        looked up by a static factory method backed by a Supplier&lt;T&gt;
        registry; and a Factory Method, ShipmentInspector.createChecklist(),
        that lets a fixed inspection sequence decide which one checklist a
        standard or hazmat shipment runs.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
