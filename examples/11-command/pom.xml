<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 11 — Command, undo, and command queues: warehouse operations.

  Standalone-buildable: `cd examples/11-command && mvn test` works without
  touching the aggregator. Also picked up by ../pom.xml's <modules>, so
  `mvn -f examples/pom.xml test` builds this module too. No containers —
  plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-11-command</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch11 Command</name>
    <description>
        Command against a warehouse operations desk: a WarehouseCommand
        interface with execute()/undo(), two commands expressed as records
        whose undo is a clean arithmetic inverse, two commands expressed as
        mutable classes that capture prior state at execute time, a
        CommandHistory undo/redo stack built on a Deque, a FIFO CommandQueue
        for deferred batch processing, and a plain functional-interface
        shortcut for a logging action with nothing to undo.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
