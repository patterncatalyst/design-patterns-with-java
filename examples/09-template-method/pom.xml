<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 9 — Template Method: shipment order processing across channels.

  Standalone-buildable: `cd examples/09-template-method && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's <modules>,
  so `mvn -f examples/pom.xml test` builds this module too. No containers —
  plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-09-template-method</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch09 Template Method</name>
    <description>
        Two idiomatic Java 25 expressions of Template Method against a
        shipment order-processing domain: a final skeleton method on an
        abstract class whose protected hooks are overridden per channel
        (retail web, wholesale, marketplace), and the same fixed sequence
        written once as a value, FunctionalOrderPipeline, whose varying
        steps are supplied as functional-interface lambdas. A shared
        OrderMath utility keeps both forms provably identical in behavior.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
