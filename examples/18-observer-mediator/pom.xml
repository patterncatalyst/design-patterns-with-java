<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 18 — Observer and Mediator: a shipment tracker and a dispatch desk.

  Standalone-buildable: `cd examples/18-observer-mediator && mvn test` works
  without touching the aggregator. Also picked up by ../pom.xml's <modules>,
  so `mvn -f examples/pom.xml test` builds this module too. No containers —
  plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-18-observer-mediator</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch18 Observer and Mediator</name>
    <description>
        Observer and Mediator against a shipping-dispatch domain. A
        ShipmentTracker subject fans a status change out to independently
        subscribed listeners, from named functional-interface observers down
        to a bare lambda, with an AutoCloseable subscription handle that
        closes the dangling-listener gap. A DispatchCoordinator mediates
        between a warehouse, a carrier, and a customer-notification station,
        none of which ever references another directly.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
