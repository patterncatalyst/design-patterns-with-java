<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 15 — Adapter, Facade, Bridge: a GlobalCourier shipping integration.

  Standalone-buildable: `cd examples/15-adapter-facade-bridge && mvn test`
  works without touching the aggregator. Also picked up by ../pom.xml's
  <modules> once the orchestrator registers it, so `mvn -f examples/pom.xml
  test` builds this module too. No containers — plain Maven + JDK 25, per
  the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-15-adapter-facade-bridge</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch15 Adapter, Facade, Bridge</name>
    <description>
        Three structural techniques taught against one GlobalCourier shipping
        integration: an Adapter that wraps a third-party rate client's awkward
        shape behind this app's own CarrierGateway interface, a Facade that
        fronts rating, labeling, customs declaration, and tracking with one
        orchestrated call, and a Bridge that lets a Notification's kind and
        its DeliveryChannel vary independently without a class per
        combination.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
