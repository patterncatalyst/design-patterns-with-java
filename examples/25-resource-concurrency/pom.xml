<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 25 — Resource and concurrency patterns: a regional dispatch hub.

  Standalone-buildable: `cd examples/25-resource-concurrency && mvn test`
  works without touching the aggregator. Also picked up by ../pom.xml's
  <modules>, so `mvn -f examples/pom.xml test` builds this module too. No
  containers — plain Maven + JDK 25, per the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-25-resource-concurrency</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch25 Resource and concurrency patterns</name>
    <description>
        A bounded CarrierConnectionPool (Semaphore + BlockingQueue, blocking
        acquire with a timeout, an AutoCloseable lease that returns the
        connection on every exit path), a DispatchDock monitor object
        (ReentrantLock + Condition serializing concurrent scanner threads),
        and a LabelPrintActiveObject (a task queue plus one dedicated worker
        thread, decoupling submission from execution), plus a ThreadLocal
        tracking-code generator and immutable-snapshot defensive copying,
        taught against a regional parcel-dispatch hub.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
