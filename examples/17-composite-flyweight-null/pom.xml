<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 17 — Composite, Flyweight, Null Object: a shipment container tree.

  Standalone-buildable: `cd examples/17-composite-flyweight-null && mvn test`
  works without touching the aggregator. Also picked up by ../pom.xml's
  <modules> once the orchestrator registers it, so `mvn -f examples/pom.xml
  test` builds this module too. No containers — plain Maven + JDK 25, per
  the repo's CLAUDE.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.patterncatalyst.designpatterns</groupId>
        <artifactId>design-patterns-with-java</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dp-17-composite-flyweight-null</artifactId>
    <packaging>jar</packaging>

    <name>Design Patterns with Java — ch17 Composite, Flyweight, Null Object</name>
    <description>
        Three idiomatic Java 25 techniques taught against a shipment container
        tree: a sealed ShipmentNode interface whose Parcel leaf and ShipmentBox
        branch are summed with one recursive pattern-matching switch, a
        FlyweightPool that interns shared PackagingSpec and Country instances
        so thousands of parcels reference a handful of descriptors, and a
        NullShipmentAlertHandler enum singleton that removes a null check from
        every weight-limit call site, contrasted with Optional resolved at the
        construction boundary.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
